{
  "mcpServers": {
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ],
      "autoApprove": [
        "get_scene_info",
        "get_object_info",
        "execute_blender_code",
        "get_viewport_screenshot"
      ],
      "disabled": true
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}